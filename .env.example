# ============================================================
# Echo Outfits — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to source control
# ============================================================

# ── General ──────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
API_BASE_URL=http://localhost:5000/api

# ── Database ─────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/echo-outfits

# ── Auth & Sessions ─────────────────────────────────────────
JWT_SECRET=your-jwt-secret-change-this
JWT_EXPIRES_IN=7d
COOKIE_DOMAIN=localhost

# ── Cloudinary (Image Storage) ──────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Payment Gateway ─────────────────────────────────────────
PAYMENT_PROVIDER=cod
# SSLCOMMERZ
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_SANDBOX=true
# aamarPay
AAMARPAY_STORE_ID=
AAMARPAY_SIGNATURE_KEY=
AAMARPAY_IS_SANDBOX=true

# ── Courier Integration ─────────────────────────────────────
COURIER_PROVIDER=manual
# Pathao
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USERNAME=
PATHAO_PASSWORD=
PATHAO_IS_SANDBOX=true
# Steadfast
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=

# ── Email (SMTP) ────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Echo Outfits
SMTP_FROM_EMAIL=

# ── SMS Provider ────────────────────────────────────────────
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_SENDER_ID=

# ── Analytics ────────────────────────────────────────────────
GA_MEASUREMENT_ID=
META_PIXEL_ID=

# ── Store Defaults ───────────────────────────────────────────
STORE_NAME=Echo Outfits
STORE_CURRENCY=BDT
STORE_TIMEZONE=Asia/Dhaka
